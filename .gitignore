# Local tooling, not part of the project
.claude/
.mcp.json

# The game itself. AzForge is built against it but does not redistribute it.
az_orginal/

# Visual Studio
.vs/
*.user
*.aps

# Build output, at the solution root and inside every project
[Dd]ebug/
[Rr]elease/
[Xx]64/
[Ww]in32/
ipch/

# Written by a post-build step, which copies the freshly linked DLL into the
# package before sealing it into a .amod
sdk/SampleMod/package/bin/
AzForge-site/*.tsx

# The plugins: everything a build of them makes
plugins/**/bin/
plugins/**/obj/
plugins/vscode/node_modules/
plugins/vscode/out/
plugins/vscode/package-lock.json
plugins/vscode/*.vsix

# The mod template has one copy, in plugins/templates. Both sides copy it in at build time,
# and those copies are output.
plugins/vscode/templates/
plugins/vs2026/Extension/Template/Mod.cpp
plugins/vs2026/Extension/Template/Mod.vcxproj
plugins/vs2026/Extension/Template/resmod/

# room_grid.py writes its dumps beside itself
tools/*.grid.txt

# Custom installer build outputs
installer/output/
installer/bin/
installer/obj/
installer/payload.zip

# AFModConstructor (Qt 6 mod constructor)
AFModConstructor/build/
AFModConstructor/build-*/
AFModConstructor/cmake-build-*/
AFModConstructor/compiler/
AFModConstructor/assets/tools/*.exe
AFModConstructor/examples/*/bin/
AFModConstructor/examples/*/build/
AFModConstructor/examples/*/.moddertool/
AFModConstructor/examples/*/src/mod_generated.c
AFModConstructor/.idea/
CMakeUserPresets.json

# Python bytecode
**/__pycache__/
*.pyc

# scratch for one chat, never committed
handoff*.txt
AFModConstructor/порядок.txt
