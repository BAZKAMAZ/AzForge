<Window x:Class="AzForgeSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AzForge Setup"
        Width="828" Height="588"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!-- Outer margin gives DropShadowEffect clean room without clipping -->
    <Grid Margin="20">
        <Border x:Name="RootFrame"
                CornerRadius="16"
                Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.65" />
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- Rounded clip so inner glows & grid stay inside the 16px corners -->
                <Grid.Clip>
                    <RectangleGeometry RadiusX="15" RadiusY="15" Rect="0,0,786,546" />
                </Grid.Clip>

                <!-- Engineering grid background -->
                <Rectangle Fill="{StaticResource GridPatternBrush}" IsHitTestVisible="False">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#44FFFFFF" Offset="0.65" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>

                <!-- Ambient forge glows (top-left & bottom-right) -->
                <Ellipse Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-150,-190,0,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#28FF7800" Offset="0" />
                            <GradientStop Color="#00FF7800" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-140,-180" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#20FF7800" Offset="0" />
                            <GradientStop Color="#00FF7800" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Top 3px orange signature bar -->
                <Border Height="3" VerticalAlignment="Top" Background="{StaticResource AccentGradient}" IsHitTestVisible="False" />

                <!-- Main vertical layout: TopBar / Content / Footer -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="66" />
                    </Grid.RowDefinitions>

                    <!-- ==================== TOP BAR ==================== -->
                    <Border Grid.Row="0"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="0,0,0,1"
                            Background="#B80E1117"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid Margin="20,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Brand mark (AFhammer vector + AzForge + version) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="8"
                                        Background="#1AFF7800" BorderBrush="#55FF7800" BorderThickness="1"
                                        Margin="0,0,10,0">
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="128" Height="128">
                                            <Path Data="M 38,108.5 L 34,108.5 L 29,105.5 L 26.5,103 L 26.5,99 L 38.5,84 L 51.5,64 L 64.5,50 L 73.5,37 L 76.5,30 L 76.5,28 L 71,23.5 L 58,24.5 L 57.5,22 L 65,17.5 L 72,15.5 L 82,16.5 L 91,20.5 L 98.5,26 L 98.5,29 L 101,31.5 L 104,31.5 L 109,34.5 L 109.5,38 L 103,46.5 L 98,44.5 L 93,38.5 L 91,37.5 L 87,38.5 L 72.5,55 L 63.5,72 L 38,108.5 Z"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  Fill="#2EFF7800"
                                                  StrokeThickness="6"
                                                  StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="AzForge"
                                           Foreground="{StaticResource TextBrush}"
                                           FontFamily="Segoe UI" FontWeight="Bold" FontSize="16"
                                           VerticalAlignment="Center" />
                                <Border Background="#1D2534" BorderBrush="#2E3A50" BorderThickness="1"
                                        CornerRadius="6" Padding="6,2" Margin="9,1,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtVersion" Text="v0.1.0"
                                               Foreground="{StaticResource TextDimBrush}"
                                               FontFamily="Consolas" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </StackPanel>

                            <!-- Step indicator pills -->
                            <StackPanel x:Name="StepperPanel" Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border x:Name="Step1Pill" CornerRadius="7" Padding="8,4" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Step1Num" Text="01" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,0,5,0" />
                                        <TextBlock x:Name="Step1Label" Text="Режим" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="·" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border x:Name="Step2Pill" CornerRadius="7" Padding="8,4" Margin="2,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Step2Num" Text="02" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,0,5,0" />
                                        <TextBlock x:Name="Step2Label" Text="Пути" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="·" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border x:Name="Step3Pill" CornerRadius="7" Padding="8,4" Margin="2,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Step3Num" Text="03" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,0,5,0" />
                                        <TextBlock x:Name="Step3Label" Text="Установка" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="·" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border x:Name="Step4Pill" CornerRadius="7" Padding="8,4" Margin="2,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Step4Num" Text="04" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,0,5,0" />
                                        <TextBlock x:Name="Step4Label" Text="Готово" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right: RU/EN switch + Minimize + Close -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource BgRaiseBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnLangRu" Content="RU" Style="{StaticResource LangToggleButton}" Click="BtnLangRu_Click" />
                                        <Button x:Name="BtnLangEn" Content="EN" Style="{StaticResource LangToggleButton}" Click="BtnLangEn_Click" />
                                    </StackPanel>
                                </Border>

                                <Button x:Name="BtnMinimize" Style="{StaticResource ChromeButton}" Click="BtnMinimize_Click" Margin="0,0,4,0">
                                    <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Button>
                                <Button x:Name="BtnClose" Style="{StaticResource ChromeCloseButton}" Click="BtnClose_Click">
                                    <Path Data="M 1,1 L 10,10 M 10,1 L 1,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ==================== PAGE HOST ==================== -->
                    <Grid x:Name="PageHost" Grid.Row="1" Margin="30,22,30,12">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PageSlide" Y="0" />
                        </Grid.RenderTransform>

                        <!-- ==================== PAGE 1: MODE ==================== -->
                        <Grid x:Name="PageMode" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                                <Border HorizontalAlignment="Left" CornerRadius="12"
                                        Background="#17FF7800" BorderBrush="#59FF7800" BorderThickness="1"
                                        Padding="11,4" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtModeKicker" Text="ПЛАТФОРМА МОДОВ ДЛЯ AZANGARA"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="Bold" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="TxtModeTitle" Text="Выберите режим установки"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="26" FontWeight="Bold" Margin="0,0,0,5" />
                                <TextBlock x:Name="TxtModeSubtitle"
                                           Text="AzForge подключается через d3d8.dll и не изменяет оригинальные файлы игры."
                                           Foreground="{StaticResource TextDimBrush}" FontSize="13.5" />
                            </StackPanel>

                            <!-- Two big interactive mode cards -->
                            <Grid Grid.Row="1" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Player -->
                                <Border x:Name="CardPlayer" Grid.Column="0" MinHeight="226"
                                        Background="{StaticResource BgPanelBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="14" Padding="20,18"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="CardPlayer_Click"
                                        MouseEnter="ModeCard_MouseEnter"
                                        MouseLeave="ModeCard_MouseLeave">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,14">
                                            <Border Width="42" Height="42" CornerRadius="11" HorizontalAlignment="Left"
                                                    Background="#1AFF7800" BorderBrush="#48FF7800" BorderThickness="1">
                                                <!-- Shield / play icon -->
                                                <Viewbox Width="20" Height="20">
                                                    <Path Data="M12,2 L4,5.5 V11.5 C4,16.8 7.4,21.5 12,23 C16.6,21.5 20,16.8 20,11.5 V5.5 Z"
                                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                          StrokeLineJoin="Round" Fill="Transparent" />
                                                </Viewbox>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Border Background="#18FF7800" BorderBrush="#44FF7800" BorderThickness="1"
                                                        CornerRadius="6" Padding="7,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtPlayerBadge" Text="РЕКОМЕНДУЕТСЯ"
                                                               Foreground="{StaticResource AccentSoftBrush}"
                                                               FontFamily="Consolas" FontSize="10" FontWeight="Bold" />
                                                </Border>
                                                <Border x:Name="CheckPlayer" Width="22" Height="22" CornerRadius="11"
                                                        Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                                                    <Viewbox x:Name="CheckPlayerMark" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="M2,7 L6,11 L14,3" Stroke="#1A0D02"
                                                              StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    </Viewbox>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock x:Name="TxtCardPlayerTitle" Grid.Row="1" Text="Для игрока"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="18" FontWeight="Bold" Margin="0,0,0,7" />

                                        <TextBlock x:Name="TxtCardPlayerDesc" Grid.Row="2"
                                                   Text="Только загрузчик модов. Ставит d3d8.dll и AzForge.dll рядом с game.exe и создаёт папку mods/."
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   FontSize="13" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,16" />

                                        <WrapPanel Grid.Row="3">
                                            <Border Style="{StaticResource TagChip}">
                                                <TextBlock Text="d3d8.dll" Foreground="{StaticResource AccentSoftBrush}" FontFamily="Consolas" FontSize="11" />
                                            </Border>
                                            <Border Style="{StaticResource TagChip}">
                                                <TextBlock Text="AzForge.dll" Foreground="{StaticResource AccentSoftBrush}" FontFamily="Consolas" FontSize="11" />
                                            </Border>
                                            <Border Style="{StaticResource TagChip}">
                                                <TextBlock Text="mods/" Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" FontSize="11" />
                                            </Border>
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <!-- Card 2: Developer -->
                                <Border x:Name="CardDev" Grid.Column="2" MinHeight="226"
                                        Background="{StaticResource BgPanelBrush}"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1.5"
                                        CornerRadius="14" Padding="20,18"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="CardDev_Click"
                                        MouseEnter="ModeCard_MouseEnter"
                                        MouseLeave="ModeCard_MouseLeave">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,14">
                                            <Border Width="42" Height="42" CornerRadius="11" HorizontalAlignment="Left"
                                                    Background="#1AFF7800" BorderBrush="#48FF7800" BorderThickness="1">
                                                <!-- Code brackets icon -->
                                                <Viewbox Width="20" Height="20">
                                                    <Path Data="M8,6 L2,12 L8,18 M16,6 L22,12 L16,18"
                                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Viewbox>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Border Background="#1D2534" BorderBrush="#2E3A50" BorderThickness="1"
                                                        CornerRadius="6" Padding="7,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtDevBadge" Text="ПОЛНЫЙ НАБОР"
                                                               Foreground="{StaticResource TextDimBrush}"
                                                               FontFamily="Consolas" FontSize="10" FontWeight="Bold" />
                                                </Border>
                                                <Border x:Name="CheckDev" Width="22" Height="22" CornerRadius="11"
                                                        Background="Transparent" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1.5">
                                                    <Viewbox x:Name="CheckDevMark" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                                        <Path Data="M2,7 L6,11 L14,3" Stroke="#1A0D02"
                                                              StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    </Viewbox>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock x:Name="TxtCardDevTitle" Grid.Row="1" Text="Для разработчика"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="18" FontWeight="Bold" Margin="0,0,0,7" />

                                        <TextBlock x:Name="TxtCardDevDesc" Grid.Row="2"
                                                   Text="Загрузчик + полный C/C++ SDK, AmodPack, AzmPack, исходники SampleMod и расширения для Visual Studio и VS Code."
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   FontSize="13" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,16" />

                                        <WrapPanel Grid.Row="3">
                                            <Border Style="{StaticResource TagChip}">
                                                <TextBlock Text="SDK" Foreground="{StaticResource AccentSoftBrush}" FontFamily="Consolas" FontSize="11" />
                                            </Border>
                                            <Border Style="{StaticResource TagChip}">
                                                <TextBlock Text="AmodPack" Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" FontSize="11" />
                                            </Border>
                                            <Border Style="{StaticResource TagChip}">
                                                <TextBlock Text="AzmPack" Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" FontSize="11" />
                                            </Border>
                                            <Border Style="{StaticResource TagChip}">
                                                <TextBlock Text="VS &amp; VS Code" Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" FontSize="11" />
                                            </Border>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ==================== PAGE 2: CONFIG ==================== -->
                        <StackPanel x:Name="PageConfig" Visibility="Collapsed">
                            <TextBlock x:Name="TxtConfigTitle" Text="Настройка установки"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtConfigSub" Text="Укажи папку игры и место для SDK."
                                       Foreground="{StaticResource TextDimBrush}" FontSize="13" Margin="0,0,0,18" />

                            <!-- Game Folder Field -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock x:Name="TxtLabelGameDir" Text="Папка игры (game.exe)"
                                           Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                <Border x:Name="BadgeGameStatus" HorizontalAlignment="Right" CornerRadius="6"
                                        Background="#1A4ADE80" BorderBrush="#444ADE80" BorderThickness="1" Padding="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="DotGameStatus" Width="6" Height="6" Fill="{StaticResource OkBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtGameStatus" Text="game.exe найден" Foreground="{StaticResource OkBrush}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InputGameDir" Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                         TextChanged="InputGameDir_TextChanged" />
                                <Button x:Name="BtnBrowseGame" Grid.Column="2" Content="Обзор…"
                                        Style="{StaticResource GhostButton}" Click="BtnBrowseGame_Click" />
                            </Grid>

                            <!-- Player-only info block -->
                            <StackPanel x:Name="PanelPlayerConfig" Visibility="Visible">
                                <Border Background="{StaticResource BgPanelBrush}"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,4,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="9" Background="#1AFF7800"
                                                BorderBrush="#44FF7800" BorderThickness="1" VerticalAlignment="Top" Margin="0,2,14,0">
                                            <Viewbox Width="16" Height="16">
                                                <Path Data="M12,2 L4,5.5 V11.5 C4,16.8 7.4,21.5 12,23 C16.6,21.5 20,16.8 20,11.5 V5.5 Z"
                                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2" Fill="Transparent" />
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="TxtPlayerInfoTitle" Text="Что будет установлено"
                                                       Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,4" />
                                            <TextBlock x:Name="TxtPlayerInfoBody"
                                                       Text="В папку игры добавятся d3d8.dll, AzForge.dll и пустая папка mods/."
                                                       Foreground="{StaticResource TextDimBrush}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <CheckBox x:Name="ChkPlayerSample" Style="{StaticResource SwitchToggle}" IsChecked="False">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtPlayerSampleTitle" Text="Установить SampleMod в mods/" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock x:Name="TxtPlayerSampleHint" Text="Демо-мод с командами консоли" Foreground="{StaticResource TextDimBrush}" FontSize="11.5" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>

                            <!-- Developer-only block -->
                            <StackPanel x:Name="PanelDevConfig" Visibility="Collapsed">
                                <TextBlock x:Name="TxtLabelSdkDir" Text="Папка SDK и инструментов"
                                           Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InputSdkDir" Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                             TextChanged="InputSdkDir_TextChanged" />
                                    <Button x:Name="BtnBrowseSdk" Grid.Column="2" Content="Обзор…"
                                            Style="{StaticResource GhostButton}" Click="BtnBrowseSdk_Click" />
                                </Grid>

                                <!-- 2x2 Switch Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox x:Name="ChkDevSample" Grid.Row="0" Grid.Column="0" Style="{StaticResource SwitchToggle}" IsChecked="True">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtDevSampleTitle" Text="Установить SampleMod в mods/" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock x:Name="TxtDevSampleHint" Text="Демо-мод с командами консоли" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="ChkAddPath" Grid.Row="0" Grid.Column="2" Style="{StaticResource SwitchToggle}" IsChecked="True">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtAddPathTitle" Text="Добавить утилиты в PATH" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock x:Name="TxtAddPathHint" Text="AmodPack и AzmPack из любого терминала" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="ChkVsCode" Grid.Row="2" Grid.Column="0" Style="{StaticResource SwitchToggle}" IsChecked="True">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtVsCodeTitle" Text="Установить расширение VS Code" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock x:Name="TxtVsCodeHint" Text="Поставит azforge-mod-tools.vsix" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="ChkVs" Grid.Row="2" Grid.Column="2" Style="{StaticResource SwitchToggle}" IsChecked="True">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtVsTitle" Text="Расширение Visual Studio (.vsix)" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock x:Name="TxtVsHint" Text="VS 2022 / 2026 — мастер модов" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                        </StackPanel>
                                    </CheckBox>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- ==================== PAGE 3: PROGRESS ==================== -->
                        <Grid x:Name="PageProgress" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtProgressTitle" Text="Установка AzForge"
                                               Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock x:Name="TxtProgressStatus" Text="Подготовка…"
                                               Foreground="{StaticResource TextDimBrush}" FontSize="13" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="TxtProgressPercent" Text="0%"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Custom Glowing Progress Bar -->
                            <Border x:Name="ProgressTrack" Grid.Row="1" Height="10" CornerRadius="5"
                                    Background="#1D2534" BorderBrush="#2E3A50" BorderThickness="1"
                                    Margin="0,0,0,18">
                                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0"
                                        CornerRadius="5" Background="{StaticResource AccentGradient}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF7800" BlurRadius="12" ShadowDepth="0" Opacity="0.55" />
                                    </Border.Effect>
                                </Border>
                            </Border>

                            <!-- Code-card style log viewer (matched to AzForge-site .code-card) -->
                            <Border Grid.Row="2" Background="{StaticResource BgCodeBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Fill="#F87171" Margin="0,0,6,0" />
                                            <Ellipse Width="9" Height="9" Fill="#FBBF24" Margin="0,0,6,0" />
                                            <Ellipse Width="9" Height="9" Fill="#34D399" Margin="0,0,12,0" />
                                            <TextBlock Text="azforge-install.log" Foreground="{StaticResource TextDimBrush}"
                                                       FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <ScrollViewer x:Name="LogScroll" Grid.Row="1" Padding="14,10"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="TxtLog"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontFamily="Consolas" FontSize="12" LineHeight="19"
                                                   TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ==================== PAGE 4: DONE ==================== -->
                        <StackPanel x:Name="PageDone" Visibility="Collapsed" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Width="52" Height="52" CornerRadius="14"
                                        Background="#1C4ADE80" BorderBrush="#554ADE80" BorderThickness="1.5"
                                        Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Viewbox Width="24" Height="24">
                                        <Path Data="M4,12.5 L9.5,18 L20,6.5"
                                              Stroke="{StaticResource OkBrush}" StrokeThickness="2.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Viewbox>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtDoneTitle" Text="AzForge установлен!"
                                               Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="Bold" />
                                    <TextBlock x:Name="TxtDoneSubtitle"
                                               Text="Нажми F10 в игре, чтобы открыть список модов."
                                               Foreground="{StaticResource TextDimBrush}" FontSize="13.5" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Installed paths summary card -->
                            <Border Background="{StaticResource BgPanelBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid x:Name="RowDoneGame" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtDoneGameLabel" Grid.Column="0" Text="Папка игры"
                                                   Foreground="{StaticResource TextDimBrush}" FontSize="12.5" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtDoneGamePath" Grid.Column="1" Text="C:\Games\Azangara"
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button x:Name="BtnOpenGameDir" Grid.Column="2" Content="открыть"
                                                Style="{StaticResource LinkButton}" Click="BtnOpenGameDir_Click" Margin="10,0,0,0" />
                                    </Grid>

                                    <Grid x:Name="RowDoneSdk" Margin="0,8,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtDoneSdkLabel" Grid.Column="0" Text="Папка SDK"
                                                   Foreground="{StaticResource TextDimBrush}" FontSize="12.5" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtDoneSdkPath" Grid.Column="1" Text="C:\AzForge"
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button x:Name="BtnOpenSdkDir" Grid.Column="2" Content="открыть"
                                                Style="{StaticResource LinkButton}" Click="BtnOpenSdkDir_Click" Margin="10,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Quick Action Buttons -->
                            <StackPanel x:Name="DoneActionsPanel" Orientation="Horizontal">
                                <Button x:Name="BtnLaunchGame" Content="Запустить Azangara"
                                        Style="{StaticResource PrimaryButton}" Click="BtnLaunchGame_Click" Margin="0,0,10,0" />
                                <Button x:Name="BtnInstallVsix" Content="Установить VS VSIX"
                                        Style="{StaticResource GhostButton}" Click="BtnInstallVsix_Click" Margin="0,0,10,0" Visibility="Collapsed" />
                                <Button x:Name="BtnOpenDocs" Content="Документация"
                                        Style="{StaticResource GhostButton}" Click="BtnOpenDocs_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ==================== PAGE 5: UNINSTALL ==================== -->
                        <StackPanel x:Name="PageUninstall" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtUninstTitle" Text="Удаление AzForge"
                                       Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="Bold" Margin="0,0,0,5" />
                            <TextBlock x:Name="TxtUninstSub"
                                       Text="Уберёт файлы загрузчика и вернёт Azangara в исходное состояние."
                                       Foreground="{StaticResource TextDimBrush}" FontSize="13.5" Margin="0,0,0,18" />

                            <Border Background="{StaticResource BgPanelBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtUninstWillRemove" Text="Будет удалено:"
                                               Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                    <TextBlock x:Name="TxtUninstSummary"
                                               Foreground="{StaticResource TextDimBrush}"
                                               FontFamily="Consolas" FontSize="12" LineHeight="20" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Background="#144ADE80" BorderBrush="#444ADE80" BorderThickness="1"
                                    CornerRadius="10" Padding="14,10">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource OkBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtUninstNotice"
                                               Text="Папка mods/ с твоими модами и оригинальные файлы Azangara НЕ будут удалены."
                                               Foreground="{StaticResource OkBrush}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ==================== FOOTER BAR ==================== -->
                    <Border Grid.Row="2"
                            BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0"
                            Background="#B80E1117" Padding="30,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left footer slot -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnBack" Content="←  Назад" Style="{StaticResource GhostButton}"
                                        Click="BtnBack_Click" Visibility="Collapsed" Margin="0,0,12,0" />
                                <Button x:Name="BtnUninstallLink" Content="Удалить AzForge" Style="{StaticResource LinkButton}"
                                        Click="BtnUninstallLink_Click" Visibility="Collapsed" Margin="0,0,14,0" />
                                <TextBlock x:Name="TxtFooterNote"
                                           Text="Windows x86  ·  Open Source  ·  Удаляется в один клик"
                                           Foreground="{StaticResource TextFaintBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Right footer slot -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnNext" Content="Продолжить  →" Style="{StaticResource PrimaryButton}"
                                        Click="BtnNext_Click" />
                                <Button x:Name="BtnDoUninstall" Content="Удалить AzForge" Style="{StaticResource DangerButton}"
                                        Click="BtnDoUninstall_Click" Visibility="Collapsed" />
                                <Button x:Name="BtnFinish" Content="Закрыть" Style="{StaticResource GhostButton}"
                                        Click="BtnClose_Click" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================== CUSTOM DARK MODAL DIALOG OVERLAY ==================== -->
                <Grid x:Name="ModalOverlay" Visibility="Collapsed" Background="#B0080A10">
                    <Border MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="{StaticResource BgRaiseBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="24,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.7" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="ModalTitle" Text="Title"
                                       Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="Bold" Margin="0,0,0,10" />
                            <TextBlock x:Name="ModalMessage" Text="Message"
                                       Foreground="{StaticResource TextDimBrush}" FontSize="13.5"
                                       TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ModalBtnCancel" Content="Нет" Style="{StaticResource GhostButton}"
                                        Click="ModalBtnCancel_Click" Margin="0,0,10,0" />
                                <Button x:Name="ModalBtnOk" Content="Да" Style="{StaticResource PrimaryButton}"
                                        Click="ModalBtnOk_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
