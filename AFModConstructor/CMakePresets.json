{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "mingw-release",
            "displayName": "Qt6 MinGW 64-bit (Release)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "environment": {
                "PATH": "C:/Qt/Tools/mingw1310_64/bin;C:/Qt/6.10.1/mingw_64/bin;C:/Qt/Tools/Ninja;$penv{PATH}"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "C:/Qt/6.10.1/mingw_64",
                "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe",
                "CMAKE_MAKE_PROGRAM": "C:/Qt/Tools/Ninja/ninja.exe",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "mingw-debug",
            "displayName": "Qt6 MinGW 64-bit (Debug)",
            "inherits": "mingw-release",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "mingw-release",
            "displayName": "Build Release",
            "configurePreset": "mingw-release"
        },
        {
            "name": "mingw-debug",
            "displayName": "Build Debug",
            "configurePreset": "mingw-debug"
        }
    ]
}
