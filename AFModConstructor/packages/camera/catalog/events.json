    "group": "camera",
    "section": "mod.sec.camControl",
    "values": [
      "view"
    ],
    "handler": "static int __cdecl %H%(AmodCameraView* view, void* user)",
    "subscribe": "if (API->camera) API->camera->SetViewHandler(SELF, %H%, 0);",
    "retDefault": "return 1;",
    "provides": "camera_view",
    "hint": "mod.ev.camView.hint"
  },
  {
    "id": "camera.placing",
    "label": "mod.ev.camPlacing",
