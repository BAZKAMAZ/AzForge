    "group": "console",
    "section": "mod.sec.general",
    "params": [
      {
        "key": "name",
        "label": "mod.p.command",
        "kind": "text",
        "preset": "mymod"
      }
    ],
    "emit": "if (API->console) API->console->RemoveCommand(SELF, \"%name%\");"
  },
  {
    "id": "console.setOpen",
    "label": "mod.act.consoleSetOpen",
    "call": "Console.SetOpen",
    "group": "console",
    "section": "mod.sec.general",
    "params": [
      {
        "key": "open",
        "label": "mod.p.consoleOpen",
        "kind": "enum",
        "preset": "1",
        "options": [
          {
            "value": "1",
            "label": "mod.console.open"
          },
          {
            "value": "0",
