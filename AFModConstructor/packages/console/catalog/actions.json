[
  {
    "id": "console.execute",
    "label": "mod.act.console",
    "call": "Console.Execute",
    "group": "console",
    "section": "mod.sec.general",
    "params": [
      {
        "key": "line",
        "label": "mod.p.line",
        "kind": "text",
        "preset": "level levels/mod.txt"
      }
    ],
    "emit": "if (API->console) API->console->Execute(SELF, \"%line%\");"
  },
  {
    "id": "console.print",
    "label": "mod.act.consolePrint",
    "call": "Console.Print",
    "group": "console",
    "section": "mod.sec.general",
    "params": [
      {
        "key": "text",
        "label": "mod.p.line",
        "kind": "text",
        "preset": ""
      },
      {
        "key": "level",
        "label": "mod.p.level",
        "kind": "enum",
        "preset": "1",
        "options": [
          {
            "value": "1",
            "label": "mod.level.always"
          },
          {
            "value": "0",
            "label": "mod.level.developer"
          }
        ]
      }
    ],
    "emit": "if (API->console) API->console->Print(SELF, %level%, \"%text%\");"
  },
  {
    "id": "console.removeCommand",
    "label": "mod.act.consoleRemove",
