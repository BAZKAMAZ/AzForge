[
  {
    "id": "files.exists",
    "label": "mod.cond.fileExists",
    "group": "files",
    "section": "mod.sec.file",
    "params": [
      {
        "key": "file",
        "label": "mod.p.gameFile",
        "kind": "text",
        "preset": "scripts/menu_main.txt"
      }
    ],
    "emit": "(files_size(\"%file%\") > 0)"
  },
  {
    "id": "files.size",
    "label": "mod.cond.fileSize",
    "group": "files",
    "section": "mod.sec.file",
    "params": [
      {
        "key": "file",
        "label": "mod.p.gameFile",
        "kind": "text",
        "preset": "scripts/menu_main.txt"
      },
      {
        "key": "op",
        "label": "mod.p.op",
        "kind": "enum",
        "preset": ">",
        "options": [
          {
            "value": "==",
            "label": "mod.op.eq"
          },
          {
            "value": "!=",
            "label": "mod.op.ne"
          },
          {
            "value": "<",
            "label": "mod.op.lt"
          },
          {
            "value": "<=",
            "label": "mod.op.le"
          },
          {
            "value": ">",
            "label": "mod.op.gt"
          },
          {
            "value": ">=",
            "label": "mod.op.ge"
          }
        ]
      },
      {
        "key": "value",
        "label": "mod.p.value",
        "kind": "number",
        "preset": "0"
      }
    ],
    "emit": "(files_size(\"%file%\") %op% %value%)"
  },
  {
    "id": "files.contains",
    "label": "mod.cond.fileContains",
    "group": "files",
    "section": "mod.sec.file",
    "params": [
      {
        "key": "file",
        "label": "mod.p.gameFile",
        "kind": "text",
        "preset": "scripts/menu_main.txt"
      },
      {
        "key": "text",
        "label": "mod.p.text",
        "kind": "text",
        "preset": "menu_id"
      }
    ],
    "emit": "files_contains(\"%file%\", \"%text%\")"
  },
  {
    "id": "files.served",
    "label": "mod.cond.fileServed",
    "group": "files",
    "section": "mod.sec.served",
    "params": [
      {
        "key": "file",
        "label": "mod.p.gameFile",
        "kind": "text",
        "preset": "scripts/menu_main.txt"
      }
    ],
    "emit": "files_is_served(\"%file%\")"
  },
  {
    "id": "files.servedCount",
    "label": "mod.cond.filesServedCount",
    "group": "files",
    "section": "mod.sec.served",
    "params": [
      {
        "key": "op",
        "label": "mod.p.op",
        "kind": "enum",
        "preset": ">",
        "options": [
          {
            "value": "==",
            "label": "mod.op.eq"
          },
          {
            "value": "!=",
            "label": "mod.op.ne"
          },
          {
            "value": "<",
            "label": "mod.op.lt"
          },
          {
            "value": "<=",
            "label": "mod.op.le"
          },
          {
            "value": ">",
            "label": "mod.op.gt"
          },
          {
            "value": ">=",
            "label": "mod.op.ge"
          }
        ]
      },
      {
        "key": "value",
        "label": "mod.p.value",
        "kind": "number",
        "preset": "0"
      }
    ],
    "emit": "(files_served_count() %op% %value%)"
  }
]
