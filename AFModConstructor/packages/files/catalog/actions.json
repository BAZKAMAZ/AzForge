    "emit": "files_append(\"%file%\", \"%text%\");"
  },
  {
    "id": "files.replace",
    "label": "mod.act.fileReplace",
    "call": "Files.Read + Serve",
    "group": "files",
    "section": "mod.sec.file",
    "params": [
      {
        "key": "file",
        "label": "mod.p.gameFile",
        "kind": "text",
        "preset": "scripts/menu_main.txt"
      },
      {
        "key": "what",
        "label": "mod.p.what",
