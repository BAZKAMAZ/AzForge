    "hint": "mod.act.playerNudgePos.hint"
  },
  {
    "id": "player.setFacing",
    "label": "mod.act.playerSetFacing",
    "call": "Player.SetFacing",
    "group": "player",
    "section": "mod.sec.playerMove",
    "params": [
      {
        "key": "by",
        "label": "mod.p.playerFaceBy",
        "kind": "enum",
        "preset": "0",
        "options": [
          {
            "value": "0",
            "label": "mod.player.faceBy.dir"
          },
          {
            "value": "1",
            "label": "mod.player.faceBy.angle"
          }
        ]
      },
      {
        "key": "dir",
        "label": "mod.p.playerFacing",
        "kind": "enum",
        "preset": "AMOD_PLAYER_FACING_RIGHT",
        "when": {
          "param": "by",
          "equals": "0"
        },
        "options": [
          {
            "value": "AMOD_PLAYER_FACING_LEFT",
            "label": "mod.player.face.left"
          },
          {
            "value": "AMOD_PLAYER_FACING_RIGHT",
            "label": "mod.player.face.right"
          }
        ]
      },
      {
        "key": "angle",
        "label": "mod.p.angle",
        "kind": "number",
        "preset": "-1.5708",
        "when": {
          "param": "by",
          "equals": "1"
        }
      }
    ],
    "emit": "if (%by% == 0) player_set_facing((float)(%dir%)); else player_set_facing((float)(%angle%));"
  },
  {
    "id": "player.setCollides",
    "label": "mod.act.playerSetCollides",
    "call": "Player.Collides + SetCollides",
    "group": "player",
    "section": "mod.sec.playerMove",
    "params": [
      {
        "key": "mode",
        "label": "mod.p.playerCollideMode",
        "kind": "enum",
        "preset": "1",
        "options": [
          {
            "value": "1",
            "label": "mod.player.col.on"
          },
          {
            "value": "0",
            "label": "mod.player.col.off"
          },
          {
            "value": "2",
            "label": "mod.player.col.toggle"
          }
        ]
      }
    ],
    "emit": "if (%mode% == 2) player_toggle_collides(); else player_set_collides(%mode%);",
    "hint": "mod.act.playerSetCollides.hint"
  },
