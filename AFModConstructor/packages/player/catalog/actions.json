[
  {
    "id": "player.setPosition",
    "label": "mod.act.playerSetPos",
    "call": "Player.SetPosition",
    "group": "player",
    "section": "mod.sec.playerMove",
    "params": [
      {
        "key": "x",
        "label": "mod.p.x",
        "kind": "number",
        "preset": "0"
      },
      {
        "key": "y",
        "label": "mod.p.y",
        "kind": "number",
        "preset": "0"
      },
      {
        "key": "z",
        "label": "mod.p.z",
        "kind": "number",
        "preset": "0"
      }
    ],
    "emit": "player_set_pos((float)(%x%), (float)(%y%), (float)(%z%), 0);",
    "hint": "mod.act.playerSetPos.hint"
  },
  {
    "id": "player.nudgePosition",
    "label": "mod.act.playerNudgePos",
    "call": "Player.SetPositionOnly",
    "group": "player",
    "section": "mod.sec.playerMove",
    "params": [
      {
        "key": "x",
        "label": "mod.p.x",
        "kind": "number",
        "preset": "0"
      },
      {
        "key": "y",
        "label": "mod.p.y",
