  {
    "id": "player.addScore",
    "label": "mod.act.addScore",
    "call": "Player.AddScore",
    "group": "player",
    "section": "mod.sec.score",
    "params": [
      {
        "key": "points",
        "label": "mod.p.points",
        "kind": "number",
        "preset": "100"
      },
      {
        "key": "where",
        "label": "mod.p.playerScoreWhere",
        "kind": "enum",
        "preset": "0",
        "options": [
          {
            "value": "0",
            "label": "mod.player.scoreAt.player"
          },
          {
            "value": "1",
            "label": "mod.player.scoreAt.pos"
          }
        ]
      },
      {
        "key": "x",
        "label": "mod.p.x",
        "kind": "number",
        "preset": "=player_position(0)",
        "when": {
          "param": "where",
          "equals": "1"
        }
      },
      {
        "key": "y",
        "label": "mod.p.y",
        "kind": "number",
        "preset": "=player_position(1) + 0.35f",
        "when": {
          "param": "where",
          "equals": "1"
        }
      },
      {
        "key": "z",
        "label": "mod.p.z",
        "kind": "number",
        "preset": "=player_position(2)",
        "when": {
          "param": "where",
          "equals": "1"
        }
      }
    ],
    "emit": "if (%where% == 0) player_add_score((int)(%points%)); else player_add_score_at((int)(%points%), (float)(%x%), (float)(%y%), (float)(%z%));",
    "hint": "mod.act.addScore.hint"
  },
  {
    "id": "player.setScore",
