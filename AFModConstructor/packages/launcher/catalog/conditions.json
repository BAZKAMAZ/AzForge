[
  {
    "id": "launcher.isOpen",
    "label": "mod.cond.launcherOpen",
    "group": "launcher",
    "emit": "(API->launcher && API->launcher->IsOpen(SELF))",
    "section": "mod.sec.dialog"
  },
  {
    "id": "launcher.textIs",
