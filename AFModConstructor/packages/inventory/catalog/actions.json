[
  {
    "id": "inventory.give",
    "label": "mod.act.invGive",
    "call": "Inventory.FindFreeSlot + PutItem",
    "group": "inventory",
    "section": "mod.sec.invSlots",
    "params": [
      {
        "key": "name",
        "label": "mod.p.invItemName",
        "kind": "text",
        "preset": "totem",
        "options": [
          {
            "value": "totem",
            "label": "mod.inv.item.totem"
          },
          {
            "value": "torch",
            "label": "mod.inv.item.torch"
          },
          {
            "value": "knife",
            "label": "mod.inv.item.knife"
          },
          {
            "value": "fomka",
            "label": "mod.inv.item.fomka"
          },
          {
            "value": "key_a",
            "label": "mod.inv.item.keyA"
          },
          {
            "value": "key_b",
            "label": "mod.inv.item.keyB"
          },
          {
            "value": "key_c",
            "label": "mod.inv.item.keyC"
          },
          {
            "value": "key_d",
            "label": "mod.inv.item.keyD"
          },
          {
            "value": "key_e",
            "label": "mod.inv.item.keyE"
          },
          {
            "value": "uni_key",
            "label": "mod.inv.item.uniKey"
          }
        ]
      },
      {
        "key": "slot",
        "label": "mod.p.invSlotOrFree",
        "kind": "number",
        "preset": "-1",
        "optional": true
      },
      {
        "key": "time",
        "label": "mod.p.seconds",
        "kind": "number",
        "preset": "0",
        "optional": true
      },
      {
        "key": "timerMode",
        "label": "mod.p.invTimerMode",
        "kind": "enum",
        "preset": "AMOD_BONUS_TIMER_GAME",
        "options": [
          {
            "value": "AMOD_BONUS_TIMER_GAME",
            "label": "mod.inv.timer.game"
          },
          {
            "value": "AMOD_BONUS_TIMER_NONE",
            "label": "mod.inv.timer.none"
          },
          {
            "value": "AMOD_BONUS_TIMER_MOD",
            "label": "mod.inv.timer.mod"
          }
        ],
        "optional": true
      }
    ],
    "emit": "inv_put_item((int)(%slot%), \"%name%\", (float)(%time%), %timerMode%);",
    "hint": "mod.act.invGive.hint"
  },
  {
