  {
    "id": "inventory.setTicking",
    "label": "mod.act.invSetTicking",
    "call": "Inventory.IsTicking + SetTicking",
    "group": "inventory",
    "section": "mod.sec.invTimers",
    "params": [
      {
        "key": "mode",
        "label": "mod.p.invTickMode",
        "kind": "enum",
        "preset": "0",
        "options": [
          {
            "value": "0",
            "label": "mod.inv.tick.pauseSlot"
          },
          {
            "value": "1",
            "label": "mod.inv.tick.resumeSlot"
          },
          {
            "value": "2",
            "label": "mod.inv.tick.toggleSlot"
          },
          {
            "value": "3",
            "label": "mod.inv.tick.pauseAll"
          },
          {
            "value": "4",
            "label": "mod.inv.tick.resumeAll"
          }
        ]
      },
      {
        "key": "slot",
        "label": "mod.p.invSlot",
        "kind": "number",
        "preset": "0",
        "when": {
          "param": "mode",
          "in": [
            "0",
            "1",
            "2"
          ]
        }
      }
    ],
    "emit": "if (%mode% == 0) inv_set_ticking((int)(%slot%), 0); else if (%mode% == 1) inv_set_ticking((int)(%slot%), 1); else if (%mode% == 2) inv_toggle_ticking((int)(%slot%)); else if (%mode% == 3) inv_set_all_ticking(0); else inv_set_all_ticking(1);",
    "hint": "mod.act.invSetTicking.hint"
  },
