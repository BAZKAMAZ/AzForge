  {
    "id": "inventory.clear",
    "label": "mod.act.invClear",
    "call": "Inventory.ClearItem",
    "group": "inventory",
    "section": "mod.sec.invSlots",
    "params": [
      {
        "key": "by",
        "label": "mod.p.invClearBy",
        "kind": "enum",
        "preset": "0",
        "options": [
          {
            "value": "0",
            "label": "mod.inv.clr.slot"
          },
          {
            "value": "1",
            "label": "mod.inv.clr.name"
          },
          {
            "value": "2",
            "label": "mod.inv.clr.all"
          }
        ]
      },
      {
        "key": "slot",
        "label": "mod.p.invSlot",
        "kind": "number",
        "preset": "0",
        "when": {
          "param": "by",
          "equals": "0"
        }
      },
      {
        "key": "name",
        "label": "mod.p.invItemName",
        "kind": "text",
        "preset": "key_a",
        "options": [
          {
            "value": "totem",
            "label": "mod.inv.item.totem"
          },
          {
            "value": "torch",
            "label": "mod.inv.item.torch"
          },
          {
            "value": "knife",
            "label": "mod.inv.item.knife"
          },
          {
            "value": "fomka",
            "label": "mod.inv.item.fomka"
          },
          {
            "value": "key_a",
            "label": "mod.inv.item.keyA"
          },
          {
            "value": "key_b",
            "label": "mod.inv.item.keyB"
          },
          {
            "value": "key_c",
            "label": "mod.inv.item.keyC"
          },
          {
            "value": "key_d",
            "label": "mod.inv.item.keyD"
          },
          {
            "value": "key_e",
            "label": "mod.inv.item.keyE"
          },
          {
            "value": "uni_key",
            "label": "mod.inv.item.uniKey"
          }
        ],
        "when": {
          "param": "by",
          "equals": "1"
        }
      }
    ],
    "emit": "if (%by% == 0) inv_clear_slot((int)(%slot%)); else if (%by% == 1) inv_clear_by_name(\"%name%\"); else inv_clear_all();",
    "hint": "mod.act.invClear.hint"
  },
