  {
    "id": "inventory.forEachSlot",
    "label": "mod.cond.invForEachSlot",
    "call": "Inventory.GetSlotCount + GetItem",
    "group": "inventory",
    "section": "mod.sec.invSlots",
    "params": [
      {
        "key": "var",
        "label": "mod.p.varName",
        "kind": "text",
        "preset": "s_idx"
      },
      {
        "key": "onlyFilled",
        "label": "mod.p.invOnlyFilled",
        "kind": "enum",
        "preset": "1",
        "options": [
          {
            "value": "1",
            "label": "common.yes"
          },
          {
            "value": "0",
            "label": "common.no"
          }
        ],
        "optional": true
      }
    ],
    "loop": "for (int %var% = 0, %var%_n = inv_slot_count(); %var% < %var%_n; ++%var%) if (inv_step_slot(%onlyFilled%, %var%))",
    "hint": "mod.cond.invForEachSlot.hint"
  },
