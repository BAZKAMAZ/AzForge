        "label": "mod.p.partLoopVar",
        "kind": "text",
        "preset": "p_idx"
      }
    ],
    "loop": "for (int %var% = 0; (%by% == 0 ? part_pick_at(%kind%, %var%) : part_pick_tagged((uint32_t)(%tag%), %var%)); ++%var%)"
