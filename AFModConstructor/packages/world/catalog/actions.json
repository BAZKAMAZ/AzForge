  {
    "id": "world.setPaused",
    "label": "mod.act.pause",
    "call": "World.IsPaused + SetPaused",
    "group": "world",
    "section": "mod.sec.level",
    "params": [
      {
        "key": "mode",
        "label": "mod.p.worldPauseMode",
        "kind": "enum",
        "preset": "1",
        "options": [
          {
            "value": "1",
            "label": "mod.world.pause.on"
          },
          {
            "value": "0",
            "label": "mod.world.pause.off"
          },
          {
            "value": "2",
            "label": "mod.world.pause.toggle"
          }
        ]
      }
    ],
    "emit": "if (%mode% == 2) world_toggle_paused(); else if (API->world && API->world->SetPaused) API->world->SetPaused(SELF, (int)(%mode%));"
  },
