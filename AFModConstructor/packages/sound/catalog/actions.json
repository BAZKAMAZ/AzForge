[
  {
    "id": "sound.play",
    "label": "mod.act.sound",
    "call": "Sound.Play",
    "group": "sound",
    "params": [
      {
        "key": "file",
        "label": "mod.p.sound",
        "kind": "sound"
      }
    ],
    "emit": "if (API->sound) { AmodSoundId s = API->sound->Load(SELF, \"%file%\"); if (s) API->sound->Play(SELF, s); }",
    "section": "mod.sec.sound"
  },
  {
    "id": "sound.music",
    "label": "mod.act.music",
    "call": "Sound.PlayMusic",
    "group": "sound",
    "params": [
      {
        "key": "file",
        "label": "mod.p.sound",
        "kind": "sound"
      }
    ],
    "emit": "if (API->sound) API->sound->PlayMusic(SELF, \"%file%\", 1, 1);",
    "section": "mod.sec.sound"
  },
  {
    "id": "sound.playAt",
    "label": "mod.act.soundAt",
    "call": "Sound.PlayAt",
    "group": "sound",
    "section": "mod.sec.sound",
    "params": [
      {
        "key": "file",
        "label": "mod.p.sound",
        "kind": "text",
        "preset": "sounds/water.wav"
      },
      {
        "key": "name",
        "label": "mod.p.voiceName",
        "kind": "text",
        "preset": "water"
      },
      {
        "key": "x",
        "label": "mod.p.x",
        "kind": "number",
        "preset": "0"
      },
      {
        "key": "y",
        "label": "mod.p.y",
        "kind": "number",
        "preset": "0"
      },
      {
        "key": "z",
        "label": "mod.p.z",
        "kind": "number",
        "preset": "0"
      },
      {
        "key": "loop",
        "label": "mod.p.loop",
        "kind": "enum",
        "preset": "1",
        "options": [
          {
            "value": "1",
            "label": "common.yes"
          },
          {
            "value": "0",
            "label": "common.no"
          }
        ]
      },
      {
        "key": "pitch",
        "label": "mod.p.pitch",
        "kind": "number",
        "preset": "1"
      }
    ],
    "emit": "sound_play_at(\"%name%\", \"%file%\", (float)(%x%), (float)(%y%), (float)(%z%), %loop%, (float)(%pitch%));"
  },
  {
