    "retDefault": "return (AmodMonsterKillResult)monsters_kill_verdict();",
    "retVeto": "return AMOD_MONSTER_KILL_REFUSE;",
    "provides": "monster_kill",
    "group": "monsters",
    "section": "mod.sec.monsterEvents",
    "hint": "mod.ev.monsterBeforeKill.hint"
  },
