      {
        "key": "monster",
        "label": "mod.p.monsterFilter",
        "kind": "text",
        "preset": "",
        "optional": true,
        "options": [
          {
            "value": "skull",
            "label": "mod.monsters.sp.skull"
          },
          {
            "value": "j_skull",
