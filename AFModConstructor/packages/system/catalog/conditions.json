        "key": "list",
        "label": "mod.p.listName",
        "kind": "text",
        "preset": ""
      },
      {
        "key": "index",
        "label": "mod.p.index",
        "kind": "number",
        "preset": "0"
      },
      {
        "key": "op",
        "label": "mod.p.op",
        "kind": "enum",
        "preset": ">",
        "options": [
          {
            "value": ">",
            "label": "mod.op.gt"
          },
          {
            "value": ">=",
            "label": "mod.op.ge"
          },
          {
            "value": "<",
            "label": "mod.op.lt"
          },
          {
            "value": "<=",
            "label": "mod.op.le"
          },
          {
            "value": "==",
            "label": "mod.op.eq"
          },
          {
            "value": "!=",
            "label": "mod.op.ne"
          }
        ]
      },
      {
        "key": "value",
