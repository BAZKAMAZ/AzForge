  {
    "id": "list.set",
    "label": "mod.act.listSet",
    "group": "system",
    "section": "mod.sec.lists",
    "params": [
      {
        "key": "list",
        "label": "mod.p.listName",
        "kind": "text",
        "preset": ""
      },
      {
        "key": "index",
        "label": "mod.p.index",
        "kind": "number",
        "preset": "0"
      },
      {
        "key": "value",
        "label": "mod.p.value",
        "kind": "number",
        "preset": "0"
      }
    ],
    "emit": "if ((int)(%index%) >= 0 && (int)(%index%) < (int)(sizeof %list% / sizeof %list%[0])) %list%[(int)(%index%)] = (float)(%value%);"
  },
  {
    "id": "list.fill",
    "label": "mod.act.listFill",
    "group": "system",
    "section": "mod.sec.lists",
    "params": [
      {
        "key": "list",
        "label": "mod.p.listName",
        "kind": "text",
        "preset": ""
      },
      {
        "key": "value",
        "label": "mod.p.value",
        "kind": "number",
        "preset": "0"
      }
    ],
    "emit": "{ int list_at; for (list_at = 0; list_at < (int)(sizeof %list% / sizeof %list%[0]); ++list_at) %list%[list_at] = (float)(%value%); }"
  },
  {
    "id": "list.identity",
    "label": "mod.act.listIdentity",
    "group": "system",
    "section": "mod.sec.lists",
    "params": [
      {
        "key": "list",
        "label": "mod.p.listName",
        "kind": "text",
        "preset": ""
      }
    ],
    "emit": "{ int list_at; for (list_at = 0; list_at < 16 && list_at < (int)(sizeof %list% / sizeof %list%[0]); ++list_at) %list%[list_at] = (list_at % 5) == 0 ? 1.0f : 0.0f; }"
  },
  {
    "id": "list.place",
    "label": "mod.act.listPlace",
    "group": "system",
    "section": "mod.sec.lists",
    "params": [
      {
        "key": "list",
        "label": "mod.p.listName",
        "kind": "text",
        "preset": ""
      },
      {
        "key": "x",
        "label": "mod.p.x",
        "kind": "number",
        "preset": "0"
      },
      {
        "key": "y",
        "label": "mod.p.y",
        "kind": "number",
        "preset": "0"
      },
      {
        "key": "z",
        "label": "mod.p.z",
        "kind": "number",
        "preset": "0"
      },
      {
        "key": "scale",
        "label": "mod.p.scale",
        "kind": "number",
        "preset": "1"
      }
    ],
    "emit": "if ((int)(sizeof %list% / sizeof %list%[0]) >= 16) { int list_at; for (list_at = 0; list_at < 16; ++list_at) %list%[list_at] = 0.0f; %list%[0] = %list%[5] = %list%[10] = (float)(%scale%); %list%[15] = 1.0f; %list%[12] = (float)(%x%); %list%[13] = (float)(%y%); %list%[14] = (float)(%z%); }"
  }
]
