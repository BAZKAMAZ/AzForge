      <UniqueIdentifier>{b2e1d4c3-6c58-4f2a-8d9b-4a8e32c7f512}</UniqueIdentifier>
    </Filter>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="SampleMod.cpp" />
  </ItemGroup>
