<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Api is a virtual folder: the headers live in the SDK, wherever that is installed, and are
       only shown here. A mod links nothing - the implementation is in AzForge.dll. -->
